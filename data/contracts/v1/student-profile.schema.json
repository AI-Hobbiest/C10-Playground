{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-hobbiest.github.io/C10-Playground/data/contracts/v1/student-profile.schema.json",
  "title": "C10 Playground Student Profile v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "profileId",
    "studentId",
    "displayName",
    "school",
    "classLevel",
    "city",
    "state",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "student-profile"
    },
    "profileId": {
      "type": "string",
      "format": "uuid"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "studentId": {
      "type": "string",
      "pattern": "^C10-[A-Z0-9-]{4,20}$"
    },
    "school": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "classLevel": {
      "type": "string",
      "enum": [
        "6",
        "7",
        "8",
        "9",
        "10",
        "11",
        "12"
      ]
    },
    "city": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "state": {
      "type": "string",
      "enum": [
        "Andhra Pradesh",
        "Arunachal Pradesh",
        "Assam",
        "Bihar",
        "Chhattisgarh",
        "Goa",
        "Gujarat",
        "Haryana",
        "Himachal Pradesh",
        "Jharkhand",
        "Karnataka",
        "Kerala",
        "Madhya Pradesh",
        "Maharashtra",
        "Manipur",
        "Meghalaya",
        "Mizoram",
        "Nagaland",
        "Odisha",
        "Punjab",
        "Rajasthan",
        "Sikkim",
        "Tamil Nadu",
        "Telangana",
        "Tripura",
        "Uttar Pradesh",
        "Uttarakhand",
        "West Bengal",
        "Andaman and Nicobar Islands",
        "Chandigarh",
        "Dadra and Nagar Haveli and Daman and Diu",
        "Delhi",
        "Jammu and Kashmir",
        "Ladakh",
        "Lakshadweep",
        "Puducherry"
      ]
    }
  },
  "additionalProperties": false
}
